# Database
DATABASE_URL=postgresql+psycopg://evidence:evidence@localhost:5432/evidenceos

# Embedding Provider: "local" (BAAI/bge-small-zh-v1.5) or "fake" (for offline testing)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat

# RAG Configuration (PRD Section 7 & 8)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
VECTOR_TOP_K=20
FULLTEXT_TOP_K=20
RRF_K=60
FINAL_TOP_K=5
MAX_REWRITES=2
